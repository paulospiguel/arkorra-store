{% doc %}
  Cartão de artigo do blog (imagem, etiqueta, data, título, resumo).

  @param {object} article - artigo Shopify
  @param {string} [read_label] - texto da ligação

  @example
  {% render 'ark-article-card', article: article, read_label: 'Ler artigo' %}
{% enddoc %}
<article class="ark-post">
  <a href="{{ article.url }}" class="ark-post__media" tabindex="-1" aria-hidden="true">
    {%- capture art_cover %}{% render 'ark-blog-art', article: article %}{% endcapture -%}
    {%- assign art_cover = art_cover | strip -%}
    {%- if article.image != blank -%}
      {{ article.image | image_url: width: 720 | image_tag: loading: 'lazy', widths: '360, 540, 720', sizes: '(min-width: 1024px) 360px, 100vw', alt: article.image.alt | default: article.title, class: 'ark-post__img' }}
    {%- elsif art_cover != blank -%}
      <img class="ark-post__img" src="{{ art_cover }}" alt="" width="720" height="405" loading="lazy">
    {%- else -%}
      <span class="ark-post__ph"><img class="ark-art" src="{{ 'ark-ic-guia.png' | asset_url }}" alt="" width="128" height="128" loading="lazy"></span>
    {%- endif -%}
  </a>
  <div class="ark-post__body">
    <p class="ark-post__meta">
      {%- if article.tags.size > 0 -%}<span class="ark-post__tag">{{ article.tags.first }}</span>{%- endif -%}
      <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | time_tag: '%d/%m/%Y' }}</time>
    </p>
    <h3 class="ark-post__title"><a href="{{ article.url }}">{{ article.title }}</a></h3>
    <p class="ark-post__excerpt">{{ article.excerpt_or_content | strip_html | truncate: 140 }}</p>
    <a href="{{ article.url }}" class="ark-post__more">{{ read_label | default: 'Ler artigo' }}<span class="ark-icon" aria-hidden="true">arrow_forward</span></a>
  </div>
</article>
