{% doc %}
Loads Arkorra Design System fonts, Material Symbols subset, base stylesheet, dynamic theme settings variables, and cart script.

@example
{% render 'ark-head' %}
{% enddoc %}
{%- liquid
  assign ark_icon_names = 'group,favorite,ac_unit,add,add_shopping_cart,arrow_forward,auto_fix_high,auto_stories,bolt,category,check,check_circle,chevron_left,chevron_right,close,delete,description,device_thermostat,download,downloading,edit,emergency_home,error,expand_more,filter_list,flash_on,grid_view,handyman,headset_mic,health_and_safety,home,import_contacts,inventory_2,label,language,local_shipping,lock,mark_email_read,medical_services,menu,menu_book,notification_important,person,phone,picture_as_pdf,power_off,published_with_changes,radio,remove,schedule,schedule_send,search,sell,shield,shield_lock,shopping_bag,star,star_half,support_agent,sync_saved_locally,task_alt,thermostat,timer,tune,verified,verified_user,warehouse,water_bottle,water_drop,water_loss,zoom_in'
-%}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;700&display=swap">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0..1,0&icon_names={{ ark_icon_names }}&display=block">
{{ 'base.css' | asset_url | stylesheet_tag }}
{%- if settings.ark_structured_data -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": {{ shop.url | append: '#organization' | json }},
          "name": {{ shop.name | json }},
          "url": {{ shop.url | json }}
          {%- if settings.favicon != blank -%}
            , "logo": {{ settings.favicon | image_url: width: 512 | prepend: 'https:' | json }}
          {%- endif -%}
        },
        {
          "@type": "WebSite",
          "@id": {{ shop.url | append: '#website' | json }},
          "url": {{ shop.url | json }},
          "name": {{ shop.name | json }},
          "inLanguage": {{ request.locale.iso_code | json }},
          "publisher": { "@id": {{ shop.url | append: '#organization' | json }} },
          "potentialAction": {
            "@type": "SearchAction",
            "target": {{ shop.url | append: routes.search_url | append: '?q={search_term_string}' | json }},
            "query-input": "required name=search_term_string"
          }
        }
        {%- if template.name == 'collection' and collection != blank -%}
          ,
          {
            "@type": "CollectionPage",
            "name": {{ collection.title | json }},
            "url": {{ shop.url | append: collection.url | json }},
            "description": {{ collection.description | strip_html | truncate: 300 | json }},
            "mainEntity": {
              "@type": "ItemList",
              "numberOfItems": {{ collection.products_count | default: 0 }},
              "itemListElement": [
                {%- for p in collection.products limit: 12 -%}
                  {
                    "@type": "ListItem",
                    "position": {{ forloop.index }},
                    "url": {{ shop.url | append: p.url | json }},
                    "name": {{ p.title | json }}
                  }{% unless forloop.last %},{% endunless %}
                {%- endfor -%}
              ]
            }
          }
        {%- endif -%}
      ]
    }
  </script>
  {%- if template.name == 'product' and product != blank -%}
    {{ product | structured_data }}
  {%- endif -%}
{%- endif -%}
{% style %}
  :root {
    --ark-pine-deep: {{ settings.ark_color_primary | default: '#0b1e2d' }};
    --ark-primary: {{ settings.ark_color_primary_dark | default: '#07141f' }};
    --ark-terracotta: {{ settings.ark_color_secondary | default: '#ff7a00' }};
    --ark-secondary: {{ settings.ark_color_secondary_dark | default: '#b34e00' }};
    --ark-sage: {{ settings.ark_color_tertiary | default: '#475569' }};
    --ark-tertiary: {{ settings.ark_color_tertiary | default: '#475569' }};
    --ark-sand: {{ settings.ark_color_neutral | default: '#f4f6f8' }};
    --ark-surface: {{ settings.ark_color_neutral | default: '#f4f6f8' }};
  }
{% endstyle %}
<script>
  window.Shopify = window.Shopify || {};
  window.Shopify.money_format = {{ shop.money_format | json }};
  document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
</script>
<script src="{{ 'ark-cart.js' | asset_url }}" defer="defer"></script>
