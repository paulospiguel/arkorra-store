{{ 'section-ark-cards.css' | asset_url | stylesheet_tag }}

{%- assign s = section.settings -%}

<section class="ark ark-steps">
  <div class="ark-page-width">
    {%- if s.heading != blank -%}
      <h2 class="ark-cards__title">{{ s.heading }}</h2>
    {%- endif -%}
    <ol class="ark-steps__list">
      {%- for block in section.blocks -%}
        <li class="ark-steps__item" {{ block.shopify_attributes }}>
          <span class="ark-steps__num" aria-hidden="true">{{ forloop.index }}</span>
          <div>
            <h3 class="ark-steps__title">{{ block.settings.title }}</h3>
            <p class="ark-steps__text">{{ block.settings.text }}</p>
          </div>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "Arkorra - Passos",
  "tag": "div",
  "class": "ark-steps-section",
  "max_blocks": 5,
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Preparar a casa em 3 passos" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Passo",
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "Escolhe o kit" },
        { "type": "textarea", "id": "text", "label": "Texto", "default": "Seleciona pelo número de pessoas e pelas necessidades de cada uma." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Arkorra - Passos",
      "blocks": [
        { "type": "step", "settings": { "title": "Escolhe o kit", "text": "Seleciona pelo número de pessoas e pelas necessidades de cada uma." } },
        { "type": "step", "settings": { "title": "Guarda num sítio acessível", "text": "Num armário perto da porta, fácil de encontrar mesmo às escuras." } },
        { "type": "step", "settings": { "title": "Revê duas vezes por ano", "text": "Confirma validades de alimentos, pilhas e medicamentos." } }
      ]
    }
  ]
}
{% endschema %}
