{{ 'section-ark-footer.css' | asset_url | stylesheet_tag }}

<footer class="ark ark-footer">
  <div class="ark-page-width">
    {%- if section.blocks.size > 0 -%}
      <div class="ark-footer__grid">
        {%- for block in section.blocks -%}
          <div class="ark-footer__col" {{ block.shopify_attributes }}>
            {%- case block.type -%}
              {%- when 'brand' -%}
                <a href="{{ routes.root_url }}" class="ark-footer__logo">
                  {%- if block.settings.logo != blank -%}
                    {{ block.settings.logo | image_url: width: 320 | image_tag: alt: shop.name, class: 'ark-footer__logo-img', loading: 'lazy' }}
                  {%- else -%}
                    <img src="{{ 'logo-2.png' | asset_img_url: '320x' }}" alt="{{ shop.name | escape }}" class="ark-footer__logo-img" width="320" height="240" loading="lazy">
                  {%- endif -%}
                </a>
                {%- if block.settings.text != blank -%}
                  <div class="ark-rte">{{ block.settings.text }}</div>
                {%- endif -%}
                {%- if block.settings.badge != blank -%}
                  <p class="ark-footer__badge">
                    <span class="ark-icon" aria-hidden="true">verified</span>
                    {{ block.settings.badge }}
                  </p>
                {%- endif -%}

              {%- when 'text' -%}
                {%- if block.settings.heading != blank -%}
                  <h3 class="ark-heading-sm">{{ block.settings.heading }}</h3>
                {%- endif -%}
                <div class="ark-rte">{{ block.settings.text }}</div>
                {%- if block.settings.note != blank -%}
                  <p class="ark-footer__note">{{ block.settings.note }}</p>
                {%- endif -%}

              {%- when 'menu' -%}
                {%- if block.settings.heading != blank -%}
                  <h3 class="ark-heading-sm">{{ block.settings.heading }}</h3>
                {%- endif -%}
                <ul class="ark-footer__links">
                  {%- for link in linklists[block.settings.menu].links -%}
                    <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                  {%- endfor -%}
                </ul>

              {%- when 'payments' -%}
                {%- if block.settings.heading != blank -%}
                  <h3 class="ark-heading-sm">{{ block.settings.heading }}</h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <p class="ark-footer__text">{{ block.settings.text }}</p>
                {%- endif -%}
                {%- assign methods = block.settings.methods | split: ',' -%}
                <ul class="ark-footer__payments">
                  {%- for method in methods -%}
                    {%- assign m = method | strip -%}
                    {%- if m != blank -%}
                      <li class="ark-footer__payment">{{ m }}</li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
                {%- if block.settings.note != blank -%}
                  <p class="ark-footer__fineprint">{{ block.settings.note }}</p>
                {%- endif -%}
            {%- endcase -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="ark-footer__bottom">
      {%- assign current_year = 'now' | date: '%Y' -%}
      <p>
        {%- if section.settings.copyright != blank -%}
          {{ section.settings.copyright | replace: '[year]', current_year }}
        {%- else -%}
          &copy; {{ current_year }} {{ shop.name }}
        {%- endif -%}
      </p>
      {%- assign legal = linklists[section.settings.legal_menu] -%}
      {%- if legal.links.size > 0 -%}
        <ul class="ark-footer__legal">
          {%- for link in legal.links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
