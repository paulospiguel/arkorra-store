{{ 'section-ark-protocol-72h.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign phases = section.blocks | where: 'type', 'phase'
  assign pillars = section.blocks | where: 'type', 'pillar'
-%}

<section class="ark ark-section ark-section--tint ark-protocol">
  <div class="ark-page-width ark-protocol__stack">
    <div class="ark-protocol__intro">
      {%- if s.eyebrow != blank -%}
        <span class="ark-eyebrow">{{ s.eyebrow }}</span>
      {%- endif -%}
      {%- if s.heading != blank -%}
        <h2 class="ark-heading-xl">{{ s.heading }}</h2>
      {%- endif -%}
      {%- if s.text != blank -%}
        <p class="ark-lede">{{ s.text }}</p>
      {%- endif -%}
    </div>

    {%- if phases.size > 0 -%}
      <ol class="ark-protocol__phases">
        {%- for block in phases -%}
          <li class="ark-card ark-protocol__phase" {{ block.shopify_attributes }}>
            <span class="ark-protocol__step" aria-hidden="true">{{ forloop.index }}</span>
            {%- if block.settings.window != blank -%}
              <span class="ark-eyebrow">{{ block.settings.window }}</span>
            {%- endif -%}
            <h3 class="ark-heading-sm">{{ block.settings.title }}</h3>
            <p class="ark-protocol__phase-text">{{ block.settings.text }}</p>
            {%- if block.settings.solution != blank -%}
              <p class="ark-protocol__solution">
                <span class="ark-icon" aria-hidden="true">{{ block.settings.icon }}</span>
                <span>{{ block.settings.solution }}</span>
              </p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}

    {%- if pillars.size > 0 -%}
      <div class="ark-protocol__pillars-box">
        {%- if s.pillars_heading != blank -%}
          <h3 class="ark-heading-md ark-protocol__pillars-title">{{ s.pillars_heading }}</h3>
        {%- endif -%}
        <ul class="ark-protocol__pillars">
          {%- for block in pillars -%}
            <li class="ark-protocol__pillar" {{ block.shopify_attributes }}>
              <span class="ark-protocol__pillar-icon"><span class="ark-icon" aria-hidden="true">{{ block.settings.icon }}</span></span>
              <strong class="ark-protocol__pillar-name">{{ block.settings.title }}</strong>
              <span class="ark-protocol__pillar-sub">{{ block.settings.subtitle }}</span>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Arkorra — Porquê 72 horas",
  "tag": "div",
  "class": "ark-protocol-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sobretítulo", "default": "Metodologia Técnica & Resiliência Civil" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Por que 72 Horas? A Janela Crítica de Isolamento" },
    { "type": "textarea", "id": "text", "label": "Descrição", "default": "Em catástrofes naturais, apagões generalizados na rede ibérica ou colapsos de abastecimento, os meios de socorro demoram em média 3 dias a normalizar o apoio porta-a-porta." },
    { "type": "text", "id": "pillars_heading", "label": "Título dos pilares", "default": "Os 6 Pilares Essenciais Contidos em Cada Kit" }
  ],
  "blocks": [
    {
      "type": "phase",
      "name": "Fase temporal",
      "limit": 4,
      "settings": [
        { "type": "text", "id": "window", "label": "Janela", "default": "0h — 12h • Fase de Choque" },
        { "type": "text", "id": "title", "label": "Título", "default": "Corte Imediato de Redes" },
        { "type": "textarea", "id": "text", "label": "Texto", "default": "Sem eletricidade, sem multibancos operacionais e falha nas antenas 4G/5G. Apenas rádio analógico funciona para obter instruções das autoridades." },
        { "type": "text", "id": "icon", "label": "Ícone", "default": "downloading" },
        { "type": "text", "id": "solution", "label": "Solução", "default": "Rádio Dínamo + Iluminação 360°" }
      ]
    },
    {
      "type": "pillar",
      "name": "Pilar essencial",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "icon", "label": "Ícone", "default": "radio" },
        { "type": "text", "id": "title", "label": "Título", "default": "Comunicação" },
        { "type": "text", "id": "subtitle", "label": "Subtítulo", "default": "Rádio FM/AM & SOS" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Arkorra — Porquê 72 horas",
      "blocks": [
        { "type": "phase", "settings": { "window": "0h — 12h • Fase de Choque", "title": "Corte Imediato de Redes", "text": "Sem eletricidade, sem multibancos operacionais e falha nas antenas 4G/5G. Apenas rádio analógico funciona para obter instruções das autoridades.", "icon": "downloading", "solution": "Rádio Dínamo + Iluminação 360°" } },
        { "type": "phase", "settings": { "window": "12h — 36h • Esgotamento Hídrico", "title": "Quebra de Pressão na Água", "text": "As estações elevatórias municipais param sem geradores. O acesso a água não tratada obriga à microfiltração e purificação imediata.", "icon": "water_bottle", "solution": "Purificação 0.1 mícron + Eletrólitos" } },
        { "type": "phase", "settings": { "window": "36h — 72h • Resgate & Apoio", "title": "Triagem e Apoio Externo", "text": "Proteção Civil prioriza hospitais e idosos institucionalizados. A sua habitação deve permanecer 100% autossuficiente até à reposição geral.", "icon": "health_and_safety", "solution": "Primeiros Socorros + Manta Térmica" } },
        { "type": "pillar", "settings": { "icon": "radio", "title": "Comunicação", "subtitle": "Rádio FM/AM & SOS" } },
        { "type": "pillar", "settings": { "icon": "water_drop", "title": "Hidratação", "subtitle": "Pastilhas + Filtro" } },
        { "type": "pillar", "settings": { "icon": "medical_services", "title": "Socorros", "subtitle": "Trauma e medicação" } },
        { "type": "pillar", "settings": { "icon": "device_thermostat", "title": "Termorregulação", "subtitle": "Mantas Mylar 90%" } },
        { "type": "pillar", "settings": { "icon": "flash_on", "title": "Energia", "subtitle": "Painel Solar & USB" } },
        { "type": "pillar", "settings": { "icon": "description", "title": "Documentos", "subtitle": "Bolsa estanque" } }
      ]
    }
  ]
}
{% endschema %}
