{{ 'section-ark-hero.css' | asset_url | stylesheet_tag }}

{%- assign s = section.settings -%}

<section class="ark ark-hero">
  <div class="ark-page-width ark-hero__grid">
    <div class="ark-hero__content">
      {%- if s.eyebrow != blank -%}
        <p class="ark-hero__eyebrow">{{ s.eyebrow }}</p>
      {%- endif -%}
      {%- if s.heading != blank -%}
        <h1 class="ark-hero__title">{{ s.heading | newline_to_br }}</h1>
      {%- endif -%}
      {%- if s.text != blank -%}
        <p class="ark-hero__text">{{ s.text }}</p>
      {%- endif -%}

      <div class="ark-hero__actions">
        {%- if s.cta_label != blank -%}
          <a href="{{ s.cta_link | default: '#catalogo' }}" class="ark-button ark-button--accent ark-button--lg">
            <span>{{ s.cta_label }}</span>
            <span class="ark-icon" aria-hidden="true">arrow_forward</span>
          </a>
        {%- endif -%}
        {%- if s.cta2_label != blank -%}
          <a href="{{ s.cta2_link | default: '#guia' }}" class="ark-button ark-button--outlined ark-button--lg ark-hero__cta-secondary">
            <span>{{ s.cta2_label }}</span>
          </a>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <ul class="ark-hero__checks">
          {%- for block in section.blocks -%}
            <li class="ark-hero__check" {{ block.shopify_attributes }}>
              <span class="ark-icon" aria-hidden="true">check</span>
              {{ block.settings.text }}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="ark-hero__media">
      {%- if s.image != blank -%}
        {{ s.image | image_url: width: 1100 | image_tag: loading: 'eager', fetchpriority: 'high', sizes: '(min-width: 1024px) 520px, 100vw', widths: '480, 720, 1100', class: 'ark-hero__img', alt: s.image.alt | default: s.heading | strip_newlines }}
      {%- else -%}
        <img src="{{ 'ark-placeholder-hero.jpg' | asset_url }}" alt="" class="ark-hero__img" width="1100" height="1000" loading="eager" fetchpriority="high">
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Arkorra - Hero",
  "tag": "div",
  "class": "ark-hero-section",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Etiqueta", "default": "PREPARAÇÃO PARA A TUA CASA" },
    { "type": "textarea", "id": "heading", "label": "Título", "info": "Usa uma nova linha para quebrar o título.", "default": "Preparados hoje.\nTranquilos amanhã." },
    { "type": "textarea", "id": "text", "label": "Texto", "default": "Kits de emergência e produtos essenciais para apagões, alertas de segurança e situações de emergência. Simples de escolher, pensados para pessoas, famílias e idosos." },
    { "type": "text", "id": "cta_label", "label": "Botão principal", "default": "Escolher o meu kit" },
    { "type": "url", "id": "cta_link", "label": "Link do botão principal" },
    { "type": "text", "id": "cta2_label", "label": "Botão secundário", "default": "Fazer o plano em 2 minutos" },
    { "type": "url", "id": "cta2_link", "label": "Link do botão secundário" },
    { "type": "image_picker", "id": "image", "label": "Imagem" }
  ],
  "blocks": [
    {
      "type": "check",
      "name": "Ponto de destaque",
      "settings": [
        { "type": "text", "id": "text", "label": "Texto", "default": "Pensado para 72 horas" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Arkorra - Hero",
      "blocks": [
        { "type": "check", "settings": { "text": "Pensado para 72 horas" } },
        { "type": "check", "settings": { "text": "Sem jargão, sem alarmismo" } },
        { "type": "check", "settings": { "text": "Guia de utilização em cada kit" } }
      ]
    }
  ]
}
{% endschema %}
