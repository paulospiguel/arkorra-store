{{ 'section-ark-testimonials.css' | asset_url | stylesheet_tag }}

{%- assign s = section.settings -%}

<section class="ark ark-section ark-testimonials">
  <div class="ark-page-width">
    <div class="ark-section-head">
      <div class="ark-section-head__text">
        {%- if s.eyebrow != blank -%}
          <span class="ark-eyebrow">{{ s.eyebrow }}</span>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 class="ark-heading-xl">{{ s.heading }}</h2>
        {%- endif -%}
      </div>
      {%- if s.badge != blank -%}
        <p class="ark-testimonials__verified">
          <span class="ark-icon" aria-hidden="true">verified_user</span>
          <span>{{ s.badge }}</span>
        </p>
      {%- endif -%}
    </div>

    <div class="ark-testimonials__grid">
      {%- for block in section.blocks -%}
        <article class="ark-card ark-testimonial" {{ block.shopify_attributes }}>
          <div class="ark-testimonial__top">
            <div class="ark-stars" aria-label="{{ block.settings.stars }} de 5 estrelas">
              {%- for i in (1..block.settings.stars) -%}
                <span class="ark-icon ark-icon--filled" aria-hidden="true">star</span>
              {%- endfor -%}
            </div>
            <blockquote class="ark-testimonial__quote">“{{ block.settings.quote }}”</blockquote>
          </div>
          <footer class="ark-testimonial__footer">
            <div class="ark-testimonial__author">
              <strong>{{ block.settings.author }}</strong>
              <span>{{ block.settings.location }}</span>
            </div>
            {%- if block.settings.tag != blank -%}
              <span class="ark-testimonial__tag">{{ block.settings.tag }}</span>
            {%- endif -%}
          </footer>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Arkorra — Testemunhos",
  "tag": "div",
  "class": "ark-testimonials-section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sobretítulo", "default": "Testemunhos Reais de Lares Preparados" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Confiança de Famílias em Toda a Península" },
    { "type": "text", "id": "badge", "label": "Selo de verificação", "default": "Avaliações Verificadas por Terceiros Independentes" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Testemunho",
      "settings": [
        { "type": "range", "id": "stars", "label": "Estrelas", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "textarea", "id": "quote", "label": "Citação", "default": "Comprei o Kit Sénior para os meus pais que vivem numa aldeia perto de Braga. O rádio é incrivelmente simples e a lanterna acende só com um toque largo. Dá-me uma tranquilidade absoluta saber que têm isto na despensa." },
        { "type": "text", "id": "author", "label": "Nome", "default": "Marta Vasconcelos" },
        { "type": "text", "id": "location", "label": "Localidade", "default": "Braga, Portugal" },
        { "type": "text", "id": "tag", "label": "Etiqueta", "default": "Compra Verificada" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Arkorra — Testemunhos",
      "blocks": [
        { "type": "review", "settings": { "stars": 5, "quote": "Comprei o Kit Sénior para os meus pais que vivem numa aldeia perto de Braga. O rádio é incrivelmente simples e a lanterna acende só com um toque largo. Dá-me uma tranquilidade absoluta saber que têm isto na despensa.", "author": "Marta Vasconcelos", "location": "Braga, Portugal", "tag": "Compra Verificada" } },
        { "type": "review", "settings": { "stars": 5, "quote": "Excelente qualidade de fabrico. Longe daquelas coisas baratas de plástico militar. O rádio carrega mesmo o telemóvel à manivela sem esforço e o manual impresso em papel plastificado em português é exemplar.", "author": "Carlos M. Figueira", "location": "Évora, Portugal", "tag": "Compra Verificada" } },
        { "type": "review", "settings": { "stars": 5, "quote": "Vivo en la sierra de Guadarrama y cuando cae una nevada fuerte solemos quedarnos sin luz. El Kit Familia Pro nos salvó de un apuro el invierno pasado. El envío por Bizum fue instantáneo y llegó en 24h.", "author": "Alejandro Gómez", "location": "Madrid, España", "tag": "Compra Verificada" } }
      ]
    }
  ]
}
{% endschema %}
