{{ 'section-ark-trust-bar.css' | asset_url | stylesheet_tag }}


<section class="ark ark-trust-bar">
  <div class="ark-page-width">
    <div class="ark-trust-bar__grid">
      {% content_for 'blocks' %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Arkorra - Garantias",
  "tag": "div",
  "class": "ark-trust-bar-section",
  "max_blocks": 4,
  "blocks": [
    { "type": "@theme" },
    { "type": "@app" }
  ],
  "presets": [
    {
      "name": "Arkorra - Garantias",
      "blocks": {
        "item_1": { "type": "ark-icon-card", "settings": { "icon": "warehouse", "tone": "primary", "title": "Armazém Ibérico", "text": "Expedição a partir de Lisboa e Madrid. Sem taxas alfandegárias nem retenções." } },
        "item_2": { "type": "ark-icon-card", "settings": { "icon": "task_alt", "tone": "secondary", "title": "Pronto a Usar", "text": "Equipamentos inspecionados, baterias carregadas a 100% e selados hermeticamente." } },
        "item_3": { "type": "ark-icon-card", "settings": { "icon": "import_contacts", "tone": "tertiary", "title": "Guia Físico PT / ES", "text": "Manual plastificado com diagramas claros para idosos e crianças sem jargão técnico." } },
        "item_4": { "type": "ark-icon-card", "settings": { "icon": "shield_lock", "tone": "primary", "title": "Pagamento Seguro", "text": "Liquidação instantânea via MB WAY, Multibanco, Bizum, Visa e Mastercard." } }
      },
      "block_order": ["item_1", "item_2", "item_3", "item_4"]
    }
  ]
}
{% endschema %}
