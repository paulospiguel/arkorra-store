{% render 'ark-guide-detail', s: section.settings, blocks: section.blocks %}

{% schema %}
{
  "name": "Arkorra - Guia digital",
  "tag": "div",
  "class": "ark-guide-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Etiqueta", "default": "GUIA DIGITAL" },
    { "type": "text", "id": "cta", "label": "Texto do botão", "default": "Comprar e descarregar" },
    { "type": "text", "id": "back_anchor", "label": "Âncora da seção de guias na home", "default": "guias" },
    { "type": "collection", "id": "related_collection", "label": "Coleção dos guias (para 'Outros guias')" },
    { "type": "textarea", "id": "disclaimer", "label": "Aviso legal" }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Pergunta",
      "settings": [
        { "type": "text", "id": "question", "label": "Pergunta" },
        { "type": "textarea", "id": "answer", "label": "Resposta" }
      ]
    }
  ],
  "presets": [{ "name": "Arkorra - Guia digital" }]
}
{% endschema %}
