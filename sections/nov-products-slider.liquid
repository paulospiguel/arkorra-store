{% assign sst = section.settings %}
{%- assign xxl = 100 | divided_by: sst.xxl -%}
{%- assign xl = 100 | divided_by: sst.xl -%}
{%- assign lg = 100 | divided_by: sst.lg -%}
{%- assign md = 100 | divided_by: sst.md -%}
{%- assign sm = 100 | divided_by: sst.sm -%}
{%- assign xs = 100 | divided_by: sst.xs -%}
{%- assign collection = collections[sst.collection] -%}
{%- assign product_limit = sst.limit -%}
<div class="distance position-relative{% if sst.style == 'style2' and sst.banner == blank %} style2{% endif %}{% if sst.class != blank %} {{ sst.class }}{% endif %}{% if sst.animate == true %} wow fadeInUp animated{% endif %}" data-section-id="{{ section.id }}" data-section-type="nov-slick">
  {% if sst.container == 'container' %}
    <div class="container">
  {% elsif sst.container == 'container-fluid' %}
    <div class="container-fluid">
  {% else %}
    <div class="container-full" style="padding: 0 {{ sst.spacing | append: 'px' }}">
  {% endif %}
    <div class="container-inner position-relative">
      {% if sst.heading != blank or sst.subheading != blank %}
        <div class="title_section {{ sst.title_alignment }}{% if sst.background_image != blank %} mb-90 mb-lg-50{% else %} mb-45{% endif %}">
          {% if sst.heading != blank %}
            <span class="title" style="color: {{ sst.heading_c }};">{{ sst.heading }}</span>
          {% endif %}
          {% if sst.subheading != blank %}
            <span class="sub_title" style="color: {{ sst.subheading_c }};">{{ sst.subheading }}</span>
          {% endif %}
        </div>
      {% endif %}
      {% if sst.show_collection %}
        <div class="nov-block__collec-flex mb-30">
          <div class="btn-toggle font-800 text-uppercase d-md-none d-flex align-items-center justify-content-between" btn-toggle data-toggle="CollecProSlider">
            <span>{{ 'sections.product_slider.category' | t }}</span>
            <i class="zmdi zmdi-chevron-down"></i>
          </div>
          <ul class="list-unstyled p-0 block-toggle" nov-toggle="CollecProSlider">
            {% for block in section.blocks %}
              <li><a href="{{ block.settings.link }}" class="font-700 d-block">{{ block.settings.title }}</a></li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}
      {% if sst.show_image_slider %}
        <div class="row spacing-{{ sst.spacing }}">
          <div class="block-image col-12 mb-md-30 position-relative" data-section-id="{{ section.id }}">
            <div class="row spacing-1 nov-slick-navfor-carousel nov-dot-style dot-small" data-items="1"{% if sst.img2 != blank or sst.img3 != blank %} data-items_md="2"{% endif %} data-autoplay="{{ sst.autoplay }}" data-autoplaytimeout="{{ sst.autoplay_speed }}" data-dots="{{ sst.img_slider_dot }}" data-nav="false" data-focus="false" data-hover="false" data-row="1">
              {% assign img_url = sst.img1 %}
              <div class="p_item">
                <div class="item position-relative nov-sh-image-2">
                {% if img_url != blank %}
                  {% if sst.l1 != blank %}
                    <a href="{{ sst.l1 }}">
                  {% endif %}
                    {%- render 'nov-aspect-image', image: img_url, aspect: 'auto' -%}
                  {% if sst.l1 != blank %}
                    </a>
                  {% endif %}
                {% else %}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                {% endif %}
                  {% if sst.t1 != blank or sst.st1 != blank %}
                    <div class="block-image__caption position-absolute bottom-center">
                      {% if sst.t1 != blank %}
                        <div class="title font-700 f_pr">{{ sst.t1 }}</div>
                      {% endif %}
                      {% if sst.st1 != blank %}
                        <div class="sub-title font-700 f_pr">{{ sst.t1 }}</div>
                      {% endif %}
                    </div>
                  {% endif %}
                </div>
              </div>
              {% assign img_url = sst.img2 %}
              {% if img_url != blank %}
              <div class="p_item">
                <div class="item position-relative nov-sh-image-2">
                  {% if sst.l2 != blank %}
                    <a href="{{ sst.l2 }}">
                  {% endif %}
                    {%- render 'nov-aspect-image', image: img_url, aspect: 'auto' -%}
                  {% if sst.l2 != blank %}
                    </a>
                  {% endif %}
                  {% if sst.t2 != blank or sst.st2 != blank %}
                  <div class="block-image__caption position-absolute bottom-center">
                    {% if sst.t2 != blank %}
                      <div class="title font-700 f_pr">{{ sst.t2 }}</div>
                    {% endif %}
                    {% if sst.st2 != blank %}
                      <div class="sub-title font-700 f_pr">{{ sst.t2 }}</div>
                    {% endif %}
                  </div>
                {% endif %}
                </div>
              </div>
              {% endif %}
              {% assign img_url = sst.img3 %}
              {% if img_url != blank %}
              <div class="p_item">
                <div class="item position-relative nov-sh-image-2">
                  {% if sst.l3 != blank %}
                    <a href="{{ sst.l3 }}">
                  {% endif %}
                  {%- render 'nov-aspect-image', image: img_url, aspect: 'auto' -%}
                  {% if sst.l3 != blank %}
                    </a>
                  {% endif %}
                  {% if sst.t3 != blank or sst.st3 != blank %}
                  <div class="block-image__caption position-absolute bottom-center">
                    {% if sst.t3 != blank %}
                      <div class="title font-700 f_pr">{{ sst.t3 }}</div>
                    {% endif %}
                    {% if sst.st3 != blank %}
                      <div class="sub-title font-700 f_pr">{{ sst.t3 }}</div>
                    {% endif %}
                  </div>
                {% endif %}
                </div>
              </div>
              {% endif %}
            </div> 
          </div>
          <div class="block-product col-12">
      {% endif %}
        {% comment %} product slider {% endcomment %}
        <div class="grid--view-items nov-slick-carousel row spacing-{{ sst.spacing }}{% if sst.show_border_item %} show-border{% endif %}"
          data-autoplay="false" 
          data-autoplayTimeout="6000" 
          data-loop="false"
          data-dots="{{ sst.show_dots }}"
          data-nav="{{ sst.show_nav }}"
          data-row="{{ sst.row_number }}"
          data-row_mobile="{{ sst.row_mobile }}"
          data-items_xxl="{{ sst.xxl }}"
          data-items="{{ sst.xl }}"
          data-items_lg="{{ sst.lg }}"
          data-items_md="{{ sst.md }}"
          data-items_sm="{{ sst.sm }}"
          data-items_xs="{{ sst.xs }}"
          data-adaptiveheight="true">
          {% for product in collection.products limit: product_limit %}
            {% if sectionId == blank %}
              {% assign sectionId = section.id %}
            {% endif %}
            <div class="block">
              <div>
                <div class="item p_item col">
                  {% render 'product-grid-item-style-1', product: product, sectionId: sectionId %}
                </div>
              </div>
            </div>
        {% else %}
          {%- for i in (1..6) -%}
            <div class="item p_item mb-30">
              {%- capture current -%}{% cycle 1, 2, 3, 4 %}{%- endcapture -%}
              {{ 'product-apparel-' | append: current | placeholder_svg_tag : 'placeholder-svg' }}
            </div>
          {%- endfor -%}
          {% endfor %}
        </div>
        {% comment %} end product slider {% endcomment %}
        {% if sst.viewall %}
          <div class="block-viewall d-flex justify-content-center mt-80">
            <a href="{{ collection.url }}" class="btn btn-xlarge">{{ 'sections.product_slider.view_all_collection' | t }}</a>
          </div>
        {% endif %}
      {% if sst.show_image_slider %}
        </div>
      </div>
      {% endif %}
    </div>
  </div>
</div>
{% schema %}
