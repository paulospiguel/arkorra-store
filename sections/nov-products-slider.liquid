{%- assign bg_image = sst.background_image -%}
<style>
  #shopify-section-{{ section.id }} .nov-slick-carousel:not(.slick-initialized) .block {
    width: {{ xs }}%;
    flex: 0 0 {{ xs }}%;
  }
  @media(min-width:  576px) {
    #shopify-section-{{ section.id }} .nov-slick-carousel:not(.slick-initialized) .block {
      width: {{ sm }}%;
      flex: 0 0 {{ sm }}%;
    }
  }
  @media(min-width:  768px) {
    #shopify-section-{{ section.id }} .nov-slick-carousel:not(.slick-initialized) .block {
      width: {{ md }}%;
      flex: 0 0 {{ md }}%;
    }
    {% if sst.show_image_slider %}
      #shopify-section-{{ section.id }} .block-image {
        width: {{ sst.wi_md }}%;
        flex:  0 0 {{ sst.wi_md }}%;
      }
      #shopify-section-{{ section.id }} .block-product {
        width: {{ sst.wp_md }}%;
        flex: 0 0 {{ sst.wp_md }}%;
      }
    {% endif %}
  }
  @media(min-width:  992px) {
    #shopify-section-{{ section.id }} .nov-slick-carousel:not(.slick-initialized) .block {
      width: {{ lg }}%;
      flex: 0 0 {{ lg }}%;
    }
    {% if sst.show_image_slider %}
      #shopify-section-{{ section.id }} .block-image {
        width: {{ sst.wi_lg }}%;
        flex:  0 0 {{ sst.wi_lg }}%;
      }
      #shopify-section-{{ section.id }} .block-product {
        width: {{ sst.wp_lg }}%;
        flex: 0 0 {{ sst.wp_lg }}%;
      }
    {% endif %}
  }
  @media(min-width:  1200px) {
    #shopify-section-{{ section.id }} .nov-slick-carousel:not(.slick-initialized) .block {
      width: {{ xl }}%;
      flex: 0 0 {{ xl }}%;
    }
    {% if sst.show_image_slider %}
      #shopify-section-{{ section.id }} .block-image {
        width: {{ sst.wi_xl }}%;
        flex:  0 0 {{ sst.wi_xl }}%;
      }
      #shopify-section-{{ section.id }} .block-product {
        width: {{ sst.wp_xl }}%;
        flex: 0 0 {{ sst.wp_xl }}%;
      }
    {% endif %}
  }
  @media(min-width:  1440px) {
    #shopify-section-{{ section.id }} .nov-slick-carousel:not(.slick-initialized) .block {
      width: {{ xxl }}%;
      flex: 0 0 {{ xxl }}%;
    }
    {% if sst.show_image_slider %}
      #shopify-section-{{ section.id }} .block-image {
        width: {{ sst.wi_xxl }}%;
        flex:  0 0 {{ sst.wi_xxl }}%;
      }
      #shopify-section-{{ section.id }} .block-product {
        width: {{ sst.wp_xxl }}%;
        flex: 0 0 {{ sst.wp_xxl }}%;
      }
    {% endif %}
  }
  @media(min-width: 1600px) {
    {% if sst.show_image_slider %}
