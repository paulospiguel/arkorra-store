{{ 'component-ark-product-card.css' | asset_url | stylesheet_tag }}
{{ 'section-ark-featured-collection.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign s = section.settings
  assign limit = s.products_to_show | default: 4
-%}

<section
  class="ark ark-section ark-catalog ark-related"
  {% if product != blank %}data-ark-recommendations="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ limit }}"{% endif %}
>
  <div class="ark-page-width">
    <div class="ark-section-head">
      <div class="ark-section-head__text">
        {%- if s.eyebrow != blank -%}
          <span class="ark-eyebrow">{{ s.eyebrow }}</span>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 class="ark-heading-xl">{{ s.heading }}</h2>
        {%- endif -%}
      </div>
    </div>

    {%- if recommendations.performed and recommendations.products_count > 0 -%}
      <div class="ark-catalog__grid">
        {%- for item in recommendations.products limit: limit -%}
          {% render 'ark-product-card', product: item, cta_label: s.cta_label %}
        {%- endfor -%}
      </div>
    {%- elsif s.fallback_collection != blank and s.fallback_collection.products_count > 0 -%}
      <div class="ark-catalog__grid" data-ark-recommendations-fallback>
        {%- assign shown = 0 -%}
        {%- for item in s.fallback_collection.products -%}
          {%- if item.id != product.id and shown < limit -%}
            {% render 'ark-product-card', product: item, cta_label: s.cta_label %}
            {%- assign shown = shown | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- elsif collections.all.products_count > 1 -%}
      <div class="ark-catalog__grid" data-ark-recommendations-fallback>
        {%- assign shown = 0 -%}
        {%- for item in collections.all.products -%}
          {%- if item.id != product.id and shown < limit -%}
            {% render 'ark-product-card', product: item, cta_label: s.cta_label %}
            {%- assign shown = shown | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="ark-catalog__grid" data-ark-recommendations-fallback>
        {% render 'ark-product-card',
          title: 'Kit Sénior & Cuidado Fácil',
          meta: 'Acessibilidade Máxima',
          excerpt: 'Botões grandes, luz difusa de segurança automática e compartimento isotérmico para medicação essencial.',
          price_text: '129,00 €',
          badge: 'Linha Sénior',
          corner: '2 Pessoas',
          image_asset: 'ark-placeholder-senior.jpg',
          cta_label: s.cta_label
        %}
        {% render 'ark-product-card',
          title: 'Kit Veículo & Deslocação',
          meta: 'Veículo & Evacuação',
          excerpt: 'Ideal para isolamento em estradas e intempéries na serra. Mala compacta anti-choque para porta-bagagens.',
          price_text: '89,00 €',
          badge: 'Estrada & Viagem',
          corner: 'Mobilidade',
          image_asset: 'ark-placeholder-veiculo.jpg',
          cta_label: s.cta_label
        %}
        {% render 'ark-product-card',
          title: 'Rádio Dínamo Solar SOS',
          meta: 'Energia Autónoma',
          excerpt: 'Receptor de boletins oficiais de proteção civil e powerbank integrado para carregamento de telemóveis.',
          price_text: '39,90 €',
          badge: 'Essencial Apagão',
          corner: 'AM/FM/SW',
          image_asset: 'ark-placeholder-radio.jpg',
          cta_label: s.cta_label
        %}
        {% render 'ark-product-card',
          title: 'Kit Família 72 Horas Pro',
          meta: 'Residência Principal • 72h',
          excerpt: 'Comunicação contínua sem energia, filtragem hídrica avançada e suprimentos alimentares desidratados.',
          price_text: '189,00 €',
          badge: 'Mais Vendido',
          corner: '3-4 Pessoas',
          image_asset: 'ark-placeholder-familia.jpg',
          cta_label: s.cta_label
        %}
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  (() => {
    const el = document.querySelector('[data-ark-recommendations*="{{ section.id }}"]');
    if (!el || !el.dataset.arkRecommendations) return;
    fetch(el.dataset.arkRecommendations)
      .then((r) => r.text())
      .then((html) => {
        const doc = new DOMParser().parseFromString(html, 'text/html');
        const next = doc.querySelector('[data-ark-recommendations]');
        if (next && next.querySelector('.ark-product-card')) {
          el.innerHTML = next.innerHTML;
        }
      })
      .catch(() => {});
  })();
</script>

{% schema %}
{
  "name": "Arkorra - Relacionados",
  "tag": "div",
  "class": "ark-related-products-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Sobretítulo", "default": "Complementos de Contingência" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Reforce a Autonomia da Sua Habitação" },
    { "type": "collection", "id": "fallback_collection", "label": "Coleção alternativa" },
    { "type": "range", "id": "products_to_show", "label": "Produtos a mostrar", "min": 2, "max": 4, "step": 1, "default": 4 },
    { "type": "text", "id": "cta_label", "label": "Texto do botão", "default": "Adicionar ao Carrinho" }
  ],
  "presets": [
    { "name": "Arkorra - Relacionados" }
  ]
}
{% endschema %}
