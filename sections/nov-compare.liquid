{% assign sst = section.settings %}
<div class="distance {% if sst.heading == blank or sst.subheading == blank %}mt-100{% endif %}{% if sst.animate == true %} wow fadeInUp animated{% endif %}{% if sst.class != blank %} {{ sst.class }}{% endif %}">
  {% if sst.container == 'container' %}
    <div class="container">
  {% elsif sst.container == 'container-fluid' %}
    <div class="container-fluid">
  {% else %}
    <div class="container-full">
  {% endif %}
    {% if sst.heading != blank or sst.subheading != blank %}
      <div class="title_section {{ sst.title_alignment }} mb-100 pb-25">
        <span class="title" style="color: {{ sst.heading_c }};">{{ sst.heading }}</span>
        {% if sst.subheading != blank %}
          <span class="sub_title" style="color: {{ sst.subheading_c }};">{{ sst.subheading }}</span>
        {% endif %}
      </div>
    {% endif %}
    <div class="container-inner">
      <div class="row no-gutters comp-column__{{ sst.column }}">
        <div class="compare compare1 col-6 position-relative">
          {% if sst.img1 != blank %}
            <div class="img"><img data-src="{{ sst.img1 | img_url: '250x' }}" class="lazyload"></div>
          {% endif %}
          <div class="title_cop {{ sst.ff }}">{{ sst.title1 }}</div>
          <div class="comp-content">
            {% for block in section.blocks %}
              {% if block.type == 'compare1' %}
                <div class="compare-item">
                  <div class="compare-content d-sm-flex align-items-center">
                    {% if sst.show_icon %}
                      <div class="p-icon text-center mb-xs-15">
                        {% if block.settings.icon != blank %}
                          <img data-src="{{ block.settings.icon | img_url: '100x' }}" class="lazyload d-inline-block">
                        {% else %}
                          {%- capture current -%}{% cycle 1, 2, 3, 4 %}{%- endcapture -%}
                          {{ 'collection-apparel-' | append: current | placeholder_svg_tag : 'placeholder-svg' }}
                        {% endif %}
                      </div>
                    {% endif %}
                    <div class="info">{{ block.settings.info }}</div>
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
        <div class="compare compare2 col-6 position-relative">
          {% if sst.img2 != blank %}
            <div class="img"><img data-src="{{ sst.img2 | img_url: '250x' }}" class="lazyload"></div>
          {% endif %}
          <div class="title_cop {{ sst.ff }}">{{ sst.title2 }}</div>
          <div class="comp-content">
            {% for block in section.blocks %}
              {% if block.type == 'compare2' %}
                <div class="compare-item">
                  <div class="compare-content d-sm-flex align-items-center">
                    {% if sst.show_icon %}
                      <div class="p-icon text-center mb-xs-15">
                        {% if block.settings.icon != blank %}
                          <img data-src="{{ block.settings.icon | img_url: '100x' }}" class="lazyload d-inline-block">
                        {% else %}
                          {%- capture current -%}{% cycle 1, 2, 3, 4 %}{%- endcapture -%}
                          {{ 'collection-apparel-' | append: current | placeholder_svg_tag : 'placeholder-svg' }}
                        {% endif %}
                      </div>
                    {% endif %}
                    <div class="info">{{ block.settings.info }}</div>
                  </div>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
{% schema %}
  {
    "name": "Vinova Compare",
    "class": "section-compare",
    "settings": [
      {
        "type": "richtext",
        "id": "heading",
        "label": "Heading",
        "default": "<p>Vinova Compare</p>"
      },
      {
        "type": "color",
        "id": "heading_c",
        "label": "Heading color",
        "default": "#222222"
      },
      {
        "type": "richtext",
        "id": "subheading",
        "label": "Sub heading",
        "default": "<p>Subtitle from happy customers</p>"
      },
      {
        "type": "color",
        "id": "subheading_c",
        "label": "Sub heading color",
        "default": "#666666"
      },
      {
        "type": "select",
        "id": "title_alignment",
        "label": "Heading alignment",
        "default": "text-center",
        "options": [
          {
            "value": "text-left",
            "label": "Left"
          },
          {
            "value": "text-center",
            "label": "Center"
          },
          {
            "value": "text-right",
            "label": "Right"
          }
        ]
      },
      {
        "type":  "header",
        "content": "Compare 1"
      },
      {
        "type": "image_picker",
        "id": "img1",
        "label": "Image"
      },
      {
        "type": "text",
        "id": "title1",
        "label": "Title",
        "default": "Lorem ipsum"
      },
      {
        "type": "color",
        "id": "bg_cop1",
        "label": "Background colors",
        "default": "#101a3d"
      },
      {
        "type":  "header",
        "content": "Compare 2"
      },
      {
        "type": "image_picker",
        "id": "img2",
        "label": "Image"
      },
      {
        "type": "text",
        "id": "title2",
        "label": "Title",
        "default": "Lorem ipsum"
      },
      {
        "type":  "header",
        "content": "Style"
      },
      {
        "type": "radio",
        "id": "column",
        "label": "Column",
        "default": "two",
        "options": [
          {
            "value": "one",
            "label": "One column"
          },
          {
            "value": "two",
            "label": "Two column"
          }
        ] 
      },
      {
        "type": "checkbox",
        "id": "show_icon",
        "label": "Show icon",
        "default": true
      },
      {
        "type": "radio",
        "id": "ff",
        "label": "Title font family",
        "default": "f_df",
        "options": [
          {
            "value": "f_df",
            "label": "Body font"
          },
          {
            "value": "f_pr",
            "label": "Heading font"
          }
        ] 
      },
      {
        "type": "color",
        "id": "t_c",
        "label": "Title color",
        "default": "#fff"
      },
      {
        "type": "color",
        "id": "i_c",
        "label": "Info color",
        "default": "#fff"
      },
      {
        "type": "checkbox",
        "id": "show_border",
        "label": "Show border bottom",
        "default": true
      },
      {
        "type": "color",
        "id": "border_c",
        "label": "Border color",
        "default": "#fff"
      },
      {
        "type": "range",
        "id": "border_opacity",
        "min": 0,
        "max": 100,
        "step": 10,
        "label": "Border opacity",
        "default": 20
      },
      {
        "type":  "header",
        "content": "Design option"
      },
      {
        "type": "checkbox",
        "id": "animate",
        "label": "Show animated",
        "default": true
      },
      {
        "type": "range",
        "id": "br_container",
        "min": 0,
        "max": 100,
        "step": 1,
        "unit": "px",
        "label": "Border radius container",
        "default": 30
      },
      {
        "type": "select",
        "id": "container",
        "label": "Container",
        "default": "container",
        "options": [
          { "value": "container", "label": "Container" },
          { "value": "container-fluid", "label": "Container fluid" },
          { "value": "container-full", "label": "Container full width" }
        ]
      },
      {
        "type": "color",
        "id": "background_color",
        "label": "Background colors",
        "default": "#124a62"
      },
      {
        "type": "image_picker",
        "id": "background_image",
        "label": "Background image"
      },
      {
        "type": "select",
        "id": "bg_size",
        "label": "Background size",
        "default": "content",
        "options": [
          { "value": "content", "label": "Container" },
          { "value": "full", "label": "Full width" }
        ]
      },
      {
        "type": "text",
        "id": "class",
        "label": "Class"
      },
      {
        "type": "number",
        "id": "distance_top",
        "label": "Top spacing section (px)",
        "default": 0
      },
      {
        "type": "number",
        "id": "distance_bottom",
        "label": "Bottom spacing section (px)",
        "default": 0
      }
    ],
    "blocks": [
      {
        "type": "compare1",
        "name": "Compare 1",
        "settings": [
          {
            "type": "image_picker",
            "id": "icon",
            "label": "Icon"
          },
          {
            "type": "richtext",
            "id": "info",
            "label": "Title",
            "default": "<p>Donec ex nunc</p>"
          }
        ]
      },
      {
        "type": "compare2",
        "name": "Compare 2",
        "settings": [
          {
            "type": "image_picker",
            "id": "icon",
            "label": "Icon"
          },
          {
            "type": "richtext",
            "id": "info",
            "label": "Title",
            "default": "<p>Donec ex nunc</p>"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Vinova Compare",
        "blocks": [
          {
            "type": "compare1"
          },
          {
            "type": "compare1"
          },
          {
            "type": "compare1"
          },
          {
            "type": "compare1"
          },
          {
            "type": "compare2"
          },
          {
            "type": "compare2"
          },
          {
            "type": "compare2"
          },
          {
            "type": "compare2"
          }
        ]
      }
    ]
  }
{% endschema %}
<style>
  {%- assign bg_image = sst.background_image -%}
  {% if sst.bg_size == 'full' %}
    #shopify-section-{{ section.id }} .distance {
      padding-top: {{ sst.distance_top | append: 'px' }};
      padding-bottom: {{ sst.distance_bottom | append: 'px' }};
      border-radius: {{ sst.br_container | append: 'px' }};
      {% if sst.background_color != blank or bg_image != blank %}
        background: {{ sst.background_color }}{% if bg_image != blank %} url("{{ bg_image | img_url: '1920x' }}"){% endif %} no-repeat center;
        background-size: cover;
      {% endif %}
    }
    @media(max-width: 991px) {
      #shopify-section-{{ section.id }} .distance {
        {%- if sst.distance_top > 20 -%}padding-top: {{ sst.distance_top | times: 0.7 | round: 0 | append: 'px' }};{%- endif -%}
        {%- if sst.distance_bottom > 20 -%}padding-bottom: {{ sst.distance_bottom | times: 0.7 | round: 0 | append: 'px' }};{%- endif -%}
      }
    }
  {% else %}
    #shopify-section-{{ section.id }} .container-inner {
      padding-top: {{ sst.distance_top | append: 'px' }};
      padding-bottom: {{ sst.distance_bottom | append: 'px' }};
      border-radius: {{ sst.br_container | append: 'px' }};
      {% if sst.background_color != blank or bg_image.src != blank %}
        background: {{ sst.background_color }}{% if bg_image != blank %} url("{{ bg_image | img_url: '1920x' }}"){% endif %} no-repeat center;
        background-size: cover;
      {% endif %}
    }
    @media(max-width: 991px) {
      #shopify-section-{{ section.id }} .container-inner {
        {%- if sst.distance_top > 20 -%}padding-top: {{ sst.distance_top | times: 0.7 | round: 0 | append: 'px' }};{%- endif -%}
        {%- if sst.distance_bottom > 20 -%}padding-bottom: {{ sst.distance_bottom | times: 0.7 | round: 0 | append: 'px' }};{%- endif -%}
      }
    }
  {% endif %}
  #shopify-section-{{ section.id }} .title_cop {
    color: {{ sst.t_c }};
  }
  #shopify-section-{{ section.id }} .info {
    color: {{ sst.i_c }};
  }
  {% if sst.bg_cop1 != 'rgba(0,0,0,0)' and sst.bg_cop1 != blank %}
    #shopify-section-{{ section.id }} .compare1 {
      background-color: {{ sst.bg_cop1 }};
      border-radius: {{ sst.br_container | append: 'px' }};
      box-shadow: 5px 0px 10px rgba(0,0,0, 0.3);
    }
  {% endif %}
  {% if sst.show_border %}
    #shopify-section-{{ section.id }} .compare-item {
      border-bottom:  1px solid rgba({{ sst.border_c | color_to_rgb | remove: 'rgb(' | remove: 'rgba(' | remove: ')' | remove: ', 0.0' }}, {{ sst.border_opacity }}%);
    }
  {% endif %}
</style>